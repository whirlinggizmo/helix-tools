#include <metal_stdlib>
#include <simd/simd.h>

using namespace metal;

struct params
{
    float4 tint;
    float4x4 turn;
};

struct main0_out
{
    float4 color [[color(0)]];
};

struct main0_in
{
    float2 v_uv [[user(locn0)]];
};

fragment main0_out main0(main0_in in [[stage_in]], constant params& _23 [[buffer(0)]], texture2d<float> image [[texture(0)]], texturecube<float> sky [[texture(1)]], sampler imageSmplr [[sampler(0)]], sampler skySmplr [[sampler(1)]])
{
    main0_out out = {};
    out.color = (image.sample(imageSmplr, in.v_uv) * _23.tint) + sky.sample(skySmplr, (_23.turn * float4(in.v_uv, 1.0, 0.0)).xyz);
    return out;
}

